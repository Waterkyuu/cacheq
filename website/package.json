{
	"name": "cacheq-docs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare:docs": "node scripts/prepare-docs.mts",
		"start": "pnpm prepare:docs && docusaurus start",
		"build": "pnpm prepare:docs && docusaurus build && go run ./search-index -build build -base-path /cacheq",
		"serve": "docusaurus serve",
		"test": "node --test scripts/*.test.mts && go test -race ./search-index",
		"lint": "oxlint --deny-warnings .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit",
		"test:build": "node --test tests/*.test.mts"
	},
	"dependencies": {
		"@docusaurus/core": "3.10.2",
		"@docusaurus/preset-classic": "3.10.2",
		"@mdx-js/react": "3.1.1",
		"clsx": "2.1.1",
		"prism-react-renderer": "2.4.1",
		"react": "19.2.0",
		"react-dom": "19.2.0"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "3.10.2",
		"@docusaurus/plugin-content-docs": "3.10.2",
		"@docusaurus/theme-classic": "3.10.2",
		"@docusaurus/tsconfig": "3.10.2",
		"@docusaurus/types": "3.10.2",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.10.0"
}
