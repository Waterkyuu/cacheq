---
import { Code } from "@astrojs/starlight/components";
const queryCode = `type User struct {
    Name string
}

loadUser := func(context.Context) (User, error) {
    return User{Name: "Alice"}, nil
}
loadUsers := func(context.Context) ([]User, error) {
    return []User{{Name: "Alice"}}, nil
}

client := cacheq.NewClient(cacheq.Options{
    StaleTime: time.Minute,
})
defer client.Close()

profile := cacheq.Query(client, "user:42", loadUser)
users := cacheq.Query(client, "users", loadUsers)
defer profile.Close()
defer users.Close()`;

const { chinese = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = `${base}${chinese ? "zh-CN/" : ""}docs/`;
const logo = `${base}cacheq.png`;
const guides = [
	{
		slug: "queries",
		title: chinese ? "查询与条件请求" : "Queries & conditions",
		description: chinese
			? "共享请求，读取状态，满足条件再加载。"
			: "Share requests, read state, and load when ready.",
		api: "Query · SetEnabled · Updates",
	},
	{
		slug: "query-options",
		title: chinese ? "查询配置" : "Query options",
		description: chinese
			? "复用查询定义，在读取、订阅和预加载间共享配置。"
			: "Reuse typed query definitions and share loading options.",
		api: "QueryOptions · QueryDefinition",
	},
	{
		slug: "cache",
		title: chinese ? "缓存与生命周期" : "Cache & lifecycle",
		description: chinese
			? "复用新鲜数据，后台刷新，自动清理缓存。"
			: "Reuse data, refresh in the background, and clean up.",
		api: "StaleTime · GCTime · Prefetch",
	},
	{
		slug: "batching",
		title: chinese ? "自动批量加载" : "Automatic batch loading",
		description: chinese
			? "合并并发请求或通过 LoadMany 加载已知 key。"
			: "Group concurrent requests or load known keys with LoadMany.",
		api: "NewBatcher · LoadMany · Fetcher",
	},
	{
		slug: "invalidation",
		title: chinese ? "失效与刷新" : "Invalidation & refresh",
		description: chinese
			? "使关联缓存失效，等待刷新并合并有界补刷。"
			: "Invalidate related data, await refreshes, and coalesce follow-ups.",
		api: "Invalidate · InvalidateAndWait · RefetchAfterLoad",
	},
	{
		slug: "query-filters",
		title: chinese ? "统一查询筛选" : "Query filters",
		description: chinese
			? "为失效、等待刷新、取消和删除复用查询筛选。"
			: "Reuse query selections for refresh, cancellation, and removal.",
		api: "QueryFilter · Keys · Predicate",
	},
	{
		slug: "query-tags",
		title: chinese ? "查询标签" : "Query tags",
		description: chinese
			? "声明查询关联，按标签刷新、取消和删除。"
			: "Declare related queries and refresh, cancel, or remove them by tag.",
		api: "QueryDefinition.Tags · QueryFilter.Tags",
	},
	{
		slug: "observability",
		title: chinese ? "可观测性" : "Observability",
		description: chinese
			? "查看缓存命中、请求合并、加载和清理统计。"
			: "Measure cache hits, shared requests, loads, and cleanup.",
		api: "Stats",
	},
	{
		slug: "mcp",
		title: chinese ? "MCP 资源缓存" : "MCP resource caching",
		description: chinese
			? "共享资源读取，保留有效期，接收变化通知。"
			: "Share resource reads, preserve TTL, and notify on changes.",
		api: "FetchWithExpiry · Invalidate · Stats",
	},
	{
		slug: "events",
		title: chinese ? "诊断事件" : "Diagnostic events",
		description: chinese
			? "按 key 记录加载原因、请求合并和缓存删除。"
			: "Trace load causes, shared requests, and removals by key.",
		api: "SubscribeEvents · LoadID · Dropped",
	},
	{
		slug: "bubbletea",
		title: chinese ? "Bubble Tea 示例" : "Bubble Tea example",
		description: chinese
			? "运行任务看板，验证多视图共享、刷新和错误恢复。"
			: "Run a task board with shared views, refreshes, and error recovery.",
		api: "Query · Updates · Invalidate",
	},
	{
		slug: "updates",
		title: chinese ? "原子缓存更新" : "Atomic cache updates",
		description: chinese ? "转换已有缓存数据，检测并发修改冲突。" : "Transform cached data without overwriting concurrent changes.",
		api: "Update · ErrUpdateConflict",
	},
	{
		slug: "mutations",
		title: chinese ? "写入与关联失效" : "Mutations & synchronization",
		description: chinese ? "订阅写入状态，成功后同步关联查询。" : "Observe writes and synchronize related queries after success.",
		api: "Mutation · SyncErr · Invalidate",
	},
	{
		slug: "execution",
		title: chinese ? "执行并发预算" : "Execution budgets",
		description: chinese ? "限制后端并发与排队数量，支持共享预算。" : "Bound backend concurrency and queued work across consumers.",
		api: "NewExecutor · MaxConcurrent · MaxQueued",
	},
];
---

<div class="home">
	<section class="home-intro">
		<img class="home-logo" src={logo} width="88" height="88" alt="cacheq" />
		<h1 id="_top">{chinese ? "Go 查询，简单一点。" : "Go queries, made simple."}</h1>
		<p>
			{chinese ? (
				<Fragment>
					一个客户端，多种数据类型。
					<br />
					共享缓存、后台刷新与按需失效。
				</Fragment>
			) : (
				<Fragment>
					One client. Many data types.
					<br />
					Shared cache, background refresh, and focused invalidation.
				</Fragment>
			)}
		</p>
		<a class="home-button" href={docs}>
			{chinese ? "开始使用" : "Get started"}
		</a>
		<div class="install-snippet">
			<Code code="go get github.com/Waterkyuu/cacheq" lang="bash" frame="none" />
		</div>
		<span class="home-requirements">
			Go 1.22+ <span>·</span> {chinese ? "核心库零依赖" : "Zero core dependencies"}
			<span>·</span> MIT
		</span>
	</section>
	<section class="home-guides" aria-label={chinese ? "功能指南" : "Feature guides"}>
		{guides.map((guide) => (
			<a class="guide-card" href={docs + guide.slug + "/"}>
				<h2>
					{guide.title}
					<span aria-hidden="true">↗</span>
				</h2>
				<p>{guide.description}</p>
				<code>{guide.api}</code>
			</a>
		))}
	</section>
	<section class="home-code">
		<h2>{chinese ? "一个客户端，多种类型。" : "One client. Different result types."}</h2>
		<p>
			{chinese
				? "User 用户详情与 []User 用户列表使用同一客户端，各自保留类型。"
				: "A User profile and a []User list share the same client, while keeping their types."}
		</p>
		<Code code={queryCode} lang="go" />
		<a class="home-inline-link" href={docs + "queries/"}>
			{chinese ? "查看完整用法" : "Read the complete guide"}
			<span aria-hidden="true">→</span>
		</a>
	</section>
</div>
