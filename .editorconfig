root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = tab
tab_width = 4

[go.mod]
indent_style = tab
indent_size = tab
tab_width = 4

[website/**.{astro,css,html,js,json,jsx,mjs,mts,ts,tsx}]
indent_style = tab
indent_size = tab
tab_width = 2

[*.md]
trim_trailing_whitespace = false
