{
  "description": "Reload repository instructions before Codex creates a Git commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/go run \"$(git rev-parse --show-toplevel)/.codex/hooks/read_agents_before_commit.go\"",
            "timeout": 30,
            "statusMessage": "Reloading AGENTS.md before commit",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
